# Build the clamav-operator-mcp binary (read-only MCP server)
# --platform=$BUILDPLATFORM : the build runs natively on the host (no QEMU overhead)
# Cross-compilation is handled via GOARCH=$TARGETARCH, natively by the Go toolchain
FROM --platform=$BUILDPLATFORM golang:1.26 as builder
ARG TARGETOS
ARG TARGETARCH
# VERSION is stamped into the MCP server identity and logs.
ARG VERSION=dev

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy the go source
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/

# Build (same optimisations as build/Dockerfile: build cache + module cache,
# no -a flag). The version is injected via -ldflags.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -ldflags "-X main.mcpVersion=${VERSION}" -o clamav-operator-mcp ./cmd/mcp-server

# Use distroless as minimal base image to package the MCP server binary
# Refer to https://github.com/GoogleContainerTools/distroless for more details
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/clamav-operator-mcp .
USER 65532:65532

ENTRYPOINT ["/clamav-operator-mcp"]
